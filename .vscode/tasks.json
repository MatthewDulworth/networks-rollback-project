{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "/opt/homebrew/bin/cmake -S . -B build && /opt/homebrew/bin/cmake --build build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            },
            "group": "build"
        },
        {
            "label": "Build and Run (two local peers)",
            "type": "shell",
            "command": "./scripts/run_local.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "/opt/homebrew/bin:${env:PATH}" }
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            },
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
